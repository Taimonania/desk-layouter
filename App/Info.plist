<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Desk Layouter</string>
	<key>CFBundleExecutable</key>
	<string>DeskLayouter</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>com.taimonania.DeskLayouter</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Desk Layouter</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.4.2</string>
	<key>CFBundleVersion</key>
	<string>8</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- Sparkle auto-update configuration (issue #45). -->
	<key>SUFeedURL</key>
	<string>https://taimonania.github.io/desk-layouter/appcast.xml</string>
	<!-- Scheduled update-check interval: every four hours (issue #129). Set here as
	     bundle configuration rather than programmatically on the updater: Sparkle
	     persists that property into the host bundle's user defaults, and user defaults
	     override this Info.plist value. Setting it at launch would burn 14400 into
	     every existing install permanently and make any future change to the interval
	     unreachable for those users. Sparkle clamps the effective interval to a
	     one-hour minimum in release builds, so four hours is well within range. -->
	<key>SUScheduledCheckInterval</key>
	<integer>14400</integer>
	<!-- EdDSA public key from Sparkle's `generate_keys`; the matching private key
	     is held out of band and signs every appcast enclosure. Rotating it would
	     invalidate installed clients' ability to verify updates. -->
	<key>SUPublicEDKey</key>
	<string>t7NzmIZFFAL1NxRDdMjyGtuORIoNj6FTLVUr8wbSBAM=</string>
</dict>
</plist>
